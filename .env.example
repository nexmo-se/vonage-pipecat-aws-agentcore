# ─────────────────────────────────────────────
# Vonage Video API credentials
# ─────────────────────────────────────────────
# Your Vonage Application ID (found in Vonage Dashboard)
VONAGE_APPLICATION_ID=your-vonage-application-id

# Path to your Vonage application private key file
VONAGE_PRIVATE_KEY=private.key

# An existing Vonage Video session ID (created by test C1 or dashboard)
VONAGE_SESSION_ID=your-vonage-session-id

# ─────────────────────────────────────────────
# AWS credentials
# ─────────────────────────────────────────────
# Preferred: use AWS CLI profile from ~/.aws/credentials + ~/.aws/config
AWS_PROFILE=vonage-dev
AWS_REGION=us-east-1

# Optional fallback (only if you are not using AWS_PROFILE)
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_SESSION_TOKEN=your-aws-session-token

# ─────────────────────────────────────────────
# AWS Bedrock model
# ─────────────────────────────────────────────
# Amazon Nova Sonic (speech-to-speech) — primary model for the agent
BEDROCK_MODEL_ID=amazon.nova-2-sonic-v1:0
# Bedrock API client tuning (retries + timeouts)
BEDROCK_CONNECT_TIMEOUT_SECONDS=10
BEDROCK_READ_TIMEOUT_SECONDS=60
BEDROCK_MAX_ATTEMPTS=4
# Validate model ID on startup; fails fast on invalid IDs
BEDROCK_VALIDATE_MODEL_ID=true

# ─────────────────────────────────────────────
# AWS Bedrock AgentCore Runtime
# ─────────────────────────────────────────────
AGENTCORE_AGENT_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/your-runtime-id

# ─────────────────────────────────────────────
# Voice Persona Configuration (Use Case Selection)
# ─────────────────────────────────────────────
# The following settings control the initial greeting and AI agent behavior/tone.
# Default: Nurse triage intake (see README Voice Persona section for other examples).

# Initial prompt seeded on session start (first turn into the LLM context).
BEDROCK_INITIAL_USER_MESSAGE=Hello, I am your nurse intake assistant. I will ask a few brief triage questions to help route your care quickly. What symptom are you experiencing now?

# AgentCore bootstrap prompt (used to shape initial tone/behavior if AGENTCORE_AGENT_ARN is set).
AGENTCORE_BOOTSTRAP_PROMPT=You are a nurse triage voice assistant. Ask one short question at a time. Capture symptom, onset, severity from 1-10, and red flags. Keep responses concise and empathetic. If severe red-flag symptoms are mentioned, advise immediate emergency care and escalate.

# ROLLBACK: Use these values to restore the generic greeting behavior:
# BEDROCK_INITIAL_USER_MESSAGE=Please greet the participant briefly and ask how you can help.
# AGENTCORE_BOOTSTRAP_PROMPT=Provide one short greeting plus one helpful follow-up question for a live voice assistant session.

# ─────────────────────────────────────────────
# Nova Sonic session guard (recommended for long-lived sessions)
# ─────────────────────────────────────────────
# Emit a renewal recommendation event before session expiry window.
NOVA_SESSION_WARN_SECONDS=410
# Session-age threshold used for renewal limit behavior.
NOVA_SESSION_LIMIT_SECONDS=470
# Optional strict mode: stop pipeline when limit is reached.
NOVA_SESSION_STOP_ON_LIMIT=false

# ─────────────────────────────────────────────
# Application server
# ─────────────────────────────────────────────
PORT=8000
